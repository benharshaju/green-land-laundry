APP_NAME="Green Land Laundry"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://greenlandlaundry.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=greenland_laundry
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@greenlandlaundry.com"
MAIL_FROM_NAME="${APP_NAME}"

# Twilio WhatsApp
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# OpenAI (for AI image generation)
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# VAT Configuration (Bahrain)
VAT_RATE=0.10
CURRENCY=BHD
CURRENCY_SYMBOL=BD

# n8n Workflow Automation
N8N_API_KEY=
N8N_BASE_URL=https://greenlandlaundry.app.n8n.cloud
N8N_WEBHOOK_URL=https://greenlandlaundry.app.n8n.cloud/webhook
N8N_WEBHOOK_SECRET=
N8N_ENABLED=true

# Hostinger Deployment
HOSTINGER_DEPLOY_HOOK=
